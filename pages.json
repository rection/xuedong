	      },
	      {
	        "pagePath": "pages/create/create",
	        "text": "创建",
	        "iconPath": "static/tabs/create.png",
	        "selectedIconPath": "static/tabs/create.png"
	      },
	      {
	        "pagePath": "pages/chat/chat",
	        "text": "聊天",
	        "iconPath": "static/tabs/chat1.png",
	        "selectedIconPath": "static/tabs/chat1.png"
	      },
	      {
	        "pagePath": "pages/sports/sports", // 关键：这里改成您的运动页面
