	    "borderStyle": "white",
	    "backgroundColor": "#FFFFFF",
	    "list": [
	      {
	        "pagePath": "pages/index/index",
	        "text": "主页",
	        "iconPath": "static/tabs/home.png",
	        "selectedIconPath": "static/tabs/home.png"
	      },
	      {
	        "pagePath": "pages/community/community",
